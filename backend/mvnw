#!/bin/sh
set -eu

MAVEN_VERSION="3.9.9"
MAVEN_BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_USER_CACHE="${MAVEN_USER_HOME:-${HOME:?MAVEN_USER_HOME or HOME must be set}}/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_HOME="$MAVEN_USER_CACHE/apache-maven-$MAVEN_VERSION"
MAVEN_ARCHIVE="$MAVEN_USER_CACHE/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Maven $MAVEN_VERSION is not cached. Downloading it..."
  mkdir -p "$MAVEN_USER_CACHE"
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz" -o "$MAVEN_ARCHIVE"
  tar -xzf "$MAVEN_ARCHIVE" -C "$MAVEN_USER_CACHE"
  rm -f "$MAVEN_ARCHIVE"
fi

exec "$MAVEN_HOME/bin/mvn" -f "$MAVEN_BASE_DIR/pom.xml" "$@"
